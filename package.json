{
  "name": "custom-element-perf-tracks",
  "version": "0.1.0",
  "description": "Shows your web components in the Chrome DevTools Performance panel, as their own custom tracks.",
  "type": "module",
  "license": "MIT",
  "author": "Den Odell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denodell/custom-element-perf-tracks.git"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "stencil",
    "performance",
    "devtools",
    "chrome-devtools",
    "performance-tracks"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "production": "./dist/production/index.js",
      "default": "./dist/index.js"
    },
    "./lit": {
      "types": "./dist/adapters/lit.d.ts",
      "production": "./dist/production/adapters/lit.js",
      "default": "./dist/adapters/lit.js"
    },
    "./stencil": {
      "types": "./dist/adapters/stencil.d.ts",
      "production": "./dist/production/adapters/stencil.js",
      "default": "./dist/adapters/stencil.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "production": "./dist/production/register.js",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/ignore-list.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && npx --yes serve -l 5173 .",
    "coverage": "npm run build && rm -rf coverage && COVERAGE_DIR=coverage/tmp NODE_V8_COVERAGE=coverage/tmp node --test test/*.test.mjs && c8 report --temp-directory coverage/tmp --report-dir coverage --include 'dist/**' --reporter text --reporter html"
  },
  "peerDependencies": {
    "lit": ">=2 <4"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@paulirish/trace_engine": "^0.0.65",
    "@stencil/core": "^4.45.1",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "lit2": "npm:lit@^2.8.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vue": "^3.5.43",
    "webpack": "^5.111.1"
  },
  "engines": {
    "node": ">=18"
  }
}
